{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Field Notes",
  "entryPointStrategy": "packages",
  "entryPoints": [
    "packages/core",
    "packages/react",
    "packages/vue",
    "packages/angular",
    "packages/sync",
    "packages/sync-server",
    "packages/sync-redis",
    "packages/vtt"
  ],
  "packageOptions": {
    "entryPoints": ["src/index.ts"],
    "readme": "README.md",
    "excludePrivate": true,
    "excludeInternal": true
  },
  "highlightLanguages": [
    "bash",
    "console",
    "css",
    "html",
    "javascript",
    "json",
    "jsonc",
    "json5",
    "yaml",
    "tsx",
    "typescript",
    "vue",
    "svelte"
  ],
  "out": "dist/api"
}
