{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Field Notes",
  "entryPointStrategy": "packages",
  "entryPoints": [
    "packages/core",
    "packages/react",
    "packages/vue",
    "packages/sync",
    "packages/sync-server",
    "packages/sync-redis",
    "packages/vtt"
  ],
  "packageOptions": {
    "entryPoints": ["src/index.ts"],
    "readme": "README.md",
    "excludePrivate": true,
    "excludeInternal": true
  },
  "out": "website/public/api"
}
