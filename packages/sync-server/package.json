{
  "name": "@fieldnotes/sync-server",
  "version": "0.25.1",
  "description": "Authoritative WebSocket relay server for Field Notes real-time sync",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm --filter @fieldnotes/core build && pnpm --filter @fieldnotes/sync build && pnpm run build",
    "fixture:build": "node test-fixtures/authority-browser/server.mjs --build",
    "fixture:start": "node test-fixtures/authority-browser/server.mjs",
    "fixture:smoke": "node test-fixtures/authority-browser/server.mjs --smoke",
    "authority-client:build": "node test-fixtures/authority-client-browser/server.mjs --build",
    "authority-client:start": "node test-fixtures/authority-client-browser/server.mjs",
    "authority-client:smoke": "node test-fixtures/authority-client-browser/server.mjs --smoke",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IrakliDevelop/fieldnotes.git",
    "directory": "packages/sync-server"
  },
  "bugs": {
    "url": "https://github.com/IrakliDevelop/fieldnotes/issues"
  },
  "homepage": "https://github.com/IrakliDevelop/fieldnotes/tree/master/packages/sync-server#readme",
  "keywords": [
    "realtime",
    "sync",
    "websocket",
    "relay",
    "collaboration",
    "fieldnotes"
  ],
  "dependencies": {
    "ws": "^8.18.0",
    "@fieldnotes/sync": "workspace:0.25.0"
  },
  "peerDependencies": {
    "@fieldnotes/core": ">=0.82.0 <1.0.0"
  },
  "devDependencies": {
    "@fieldnotes/core": "workspace:*",
    "@fieldnotes/vtt": "workspace:*",
    "@types/ws": "^8.5.12",
    "@vitest/coverage-v8": "^4.1.11",
    "tsup": "^8.5.1",
    "vitest": "^4.1.11"
  }
}
