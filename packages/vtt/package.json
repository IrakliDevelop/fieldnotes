{
  "name": "@fieldnotes/vtt",
  "version": "0.4.0",
  "description": "VTT domain tools and overlays for Field Notes canvas SDK",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IrakliDevelop/fieldnotes.git",
    "directory": "packages/vtt"
  },
  "bugs": {
    "url": "https://github.com/IrakliDevelop/fieldnotes/issues"
  },
  "homepage": "https://github.com/IrakliDevelop/fieldnotes/tree/master/packages/vtt#readme",
  "keywords": [
    "canvas",
    "infinite-canvas",
    "vtt",
    "tabletop",
    "fog-of-war",
    "measurement",
    "fieldnotes"
  ],
  "peerDependencies": {
    "@fieldnotes/core": ">=0.75.0 <1.0.0"
  },
  "devDependencies": {
    "@fieldnotes/core": "workspace:*",
    "@vitest/coverage-v8": "^4.1.0",
    "tsup": "^8.5.1",
    "vitest": "^4.1.0"
  }
}
