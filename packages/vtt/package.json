{
  "name": "@fieldnotes/vtt",
  "version": "0.9.1",
  "description": "VTT domain tools and overlays for Field Notes canvas SDK",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./sync": {
      "import": {
        "types": "./dist/sync.d.ts",
        "default": "./dist/sync.js"
      },
      "require": {
        "types": "./dist/sync.d.cts",
        "default": "./dist/sync.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./redis": {
      "import": {
        "types": "./dist/redis.d.ts",
        "default": "./dist/redis.js"
      },
      "require": {
        "types": "./dist/redis.d.cts",
        "default": "./dist/redis.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IrakliDevelop/fieldnotes.git",
    "directory": "packages/vtt"
  },
  "bugs": {
    "url": "https://github.com/IrakliDevelop/fieldnotes/issues"
  },
  "homepage": "https://github.com/IrakliDevelop/fieldnotes/tree/master/packages/vtt#readme",
  "keywords": [
    "canvas",
    "infinite-canvas",
    "vtt",
    "tabletop",
    "fog-of-war",
    "measurement",
    "fieldnotes"
  ],
  "peerDependencies": {
    "@fieldnotes/core": ">=0.82.0 <1.0.0",
    "@fieldnotes/sync": ">=0.19.0 <1.0.0",
    "@fieldnotes/sync-server": ">=0.18.0 <1.0.0",
    "@fieldnotes/sync-redis": ">=0.10.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@fieldnotes/sync": {
      "optional": true
    },
    "@fieldnotes/sync-server": {
      "optional": true
    },
    "@fieldnotes/sync-redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fieldnotes/core": "workspace:*",
    "@fieldnotes/sync": "workspace:*",
    "@fieldnotes/sync-server": "workspace:*",
    "@fieldnotes/sync-redis": "workspace:*",
    "@vitest/coverage-v8": "^4.1.0",
    "tsup": "^8.5.1",
    "vitest": "^4.1.0"
  }
}
