{
  "name": "@fieldnotes/vue",
  "version": "0.1.1",
  "description": "Vue wrapper for Field Notes canvas SDK",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IrakliDevelop/fieldnotes.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/IrakliDevelop/fieldnotes/issues"
  },
  "homepage": "https://github.com/IrakliDevelop/fieldnotes/tree/master/packages/vue#readme",
  "keywords": [
    "canvas",
    "infinite-canvas",
    "vue",
    "html-embedding",
    "fieldnotes"
  ],
  "peerDependencies": {
    "@fieldnotes/core": ">=0.98.0 <1.0.0",
    "vue": ">=3.5 <4"
  },
  "devDependencies": {
    "@fieldnotes/core": "workspace:*",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^29.1.1",
    "tsup": "^8.5.1",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  }
}
