---
import type { ComponentProps } from 'astro/types';
import '../styles/fonts';
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { link } from '../utils/base';

interface Props {
  title: string;
  description: string;
  current?: ComponentProps<typeof Header>['current'];
}

const { title, description, current } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={link('/favicon.svg')} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <slot name="head" />
  </head>
  <body>
    <Header current={current}><slot name="search" slot="search" /></Header>
    <slot />
    <Footer />
  </body>
</html>
