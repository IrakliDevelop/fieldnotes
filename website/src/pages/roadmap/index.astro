---
import roadmap from '../../../content/roadmap.md?raw';
import TrailMap from '../../components/TrailMap.astro';
import Base from '../../layouts/Base.astro';
import { parseRoadmap } from '../../lib/roadmap';
import { trailMap } from '../../lib/trail';
import { link } from '../../utils/base';

const { built, next, notBuilt } = parseRoadmap(roadmap);
const map = trailMap({ built, next, notBuilt });
const RECENT = 5;
const earlier = built.slice(0, Math.max(0, built.length - RECENT));
const recent = built.slice(earlier.length);
---

<Base
  title="Roadmap, Field Notes"
  description="What is built in Field Notes, what comes next and what is not built yet."
  current="roadmap"
>
  <main class="wrap roadmap">
    <div class="columns">
      <div class="list">
      <h1>Roadmap</h1>
      <div class="intro">
        <p>
          This is what I've built into Field Notes so far, what I'm working on next and what isn't
          built yet. The pull request that finishes an item moves it to Built, and the <a
            href={link('/changelog/')}>changelog</a
          > dates each release.
        </p>
        <p class="signature">Irakli</p>
      </div>

      <section aria-labelledby="built">
        <h2 id="built">Built</h2>
        {
          earlier.length > 0 && (
            <details class="fold">
              <summary>
                <span class="closed"
                  ><svg
                    aria-hidden="true"
                    width="16"
                    height="16"
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M8 1v5M5.5 3.5L8 1l2.5 2.5M8 15v-5M5.5 12.5L8 15l2.5-2.5M2 8" /></svg
                  >Show items 1–{earlier.length}</span
                >
                <span class="open"
                  ><svg
                    aria-hidden="true"
                    width="16"
                    height="16"
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M8 6V1M5.5 3.5L8 6l2.5-2.5M8 10v5M5.5 12.5L8 10l2.5 2.5M2 8" /></svg
                  >Hide items 1–{earlier.length}</span
                >
              </summary>
              <ol start="1">{earlier.map((item) => <li>{item}</li>)}</ol>
            </details>
          )
        }
        <ol start={earlier.length + 1}>{recent.map((item) => <li>{item}</li>)}</ol>
      </section>

      {
        next.length > 0 && (
          <section aria-labelledby="next">
            <h2 id="next">Next</h2>
            <ol start={built.length + 1}>{next.map((item) => <li>{item}</li>)}</ol>
          </section>
        )
      }

      {
        notBuilt.length > 0 && (
          <section class="unpaved" aria-labelledby="not-built">
            <h2 id="not-built">Not built yet</h2>
            <ol start={built.length + next.length + 1}>{notBuilt.map((item) => <li>{item}</li>)}</ol>
          </section>
        )
      }
      </div>
      <div class="map" data-trail-map aria-hidden="true">
        <TrailMap map={map} />
      </div>
    </div>
  </main>
</Base>

<style>
  .roadmap {
    padding-top: 48px;
    padding-bottom: 96px;
  }

  .columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: 56px;
    align-items: start;
  }

  .map {
    display: none;
  }

  h1 {
    margin: 0;
    font-size: 44px;
    line-height: 1.1;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 36em;
    color: var(--graphite-2);
    font-size: 19px;
    line-height: 1.6;
  }

  .intro p {
    margin: 0;
  }

  .signature {
    font-family: 'Young Serif', serif;
    font-size: 22px;
  }

  h1 + .intro {
    margin-top: 14px;
  }

  section {
    margin-top: 40px;
  }

  h2 {
    margin: 0;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--divider);
    font-size: 28px;
    line-height: 1.2;
  }

  @counter-style trail {
    system: extends decimal;
    suffix: ' ';
  }

  ol {
    margin: 0;
    padding: 0 0 0 52px;
    list-style: trail;
  }

  li {
    padding: 11px 0;
    border-bottom: 1px solid var(--divider-2);
  }

  li::marker {
    color: var(--muted);
    font: 13px 'JetBrains Mono', monospace;
  }

  section[aria-labelledby='next'] li {
    font-weight: 500;
  }

  .unpaved li {
    color: var(--muted);
  }

  .fold summary {
    display: flex;
    align-items: center;
    min-height: 44px;
    margin: 6px 0;
    padding: 0 14px;
    border-radius: 4px;
    background: var(--code-bg);
    font: 500 15px/1.4 'Public Sans', sans-serif;
    cursor: pointer;
    list-style: none;
  }

  .fold summary::-webkit-details-marker {
    display: none;
  }

  .fold summary:hover {
    background: #dfe2dc;
  }

  .closed,
  .open {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .fold[open] .closed,
  .fold:not([open]) .open {
    display: none;
  }

  @media (min-width: 1000px) {
    .columns {
      grid-template-columns: minmax(0, 1fr) min(460px, 36%);
    }

    .map {
      display: block;
      position: sticky;
      top: 24px;
    }
  }

  @media (max-width: 480px) {
    h1 {
      font-size: 34px;
    }
  }
</style>
