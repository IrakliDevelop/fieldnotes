{
  "name": "fieldnotes-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/astro-node.mjs astro dev",
    "build": "node scripts/astro-node.mjs astro build && node scripts/astro-node.mjs pagefind --site dist",
    "preview": "node scripts/astro-node.mjs astro preview --port 4321",
    "typecheck": "node scripts/astro-node.mjs astro check",
    "test": "vitest run && node --test scripts/*.test.mjs && node scripts/design-ratchet.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@astrojs/markdown-remark": "^7.3.3",
    "@axe-core/playwright": "^4.14.0",
    "@fieldnotes/core": "workspace:*",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@fontsource/young-serif": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/mdast": "^4.0.4",
    "astro": "^7.4.1",
    "pagefind": "^1.5.2",
    "remark-directive": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "typescript": "~6.0.3",
    "unified": "^11.0.5",
    "vitest": "^5.0.5"
  }
}
